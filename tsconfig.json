{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "#core": ["./packages/core/src/index.ts"],
      "#core/*": ["./packages/core/src/*"],
      "#adapter/*": ["./packages/adapters/*/src/index.ts"],
      "#adapters": ["./packages/adapters/index.ts"],
      "#registry-browser": ["./packages/adapters/registry.ts"],
      "#web-kit": ["./packages/web-kit/src/index.ts"],
      "#api": ["./apps/web/src/api.ts"]
    }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "scripts/**/*.mjs"]
}
